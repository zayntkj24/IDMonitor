# IDmonitor Environment Configuration
# Copy this to .env and fill in values

# Application
APP_NAME=IDmonitor
APP_ENV=production
APP_DEBUG=false
APP_PORT=8080
APP_FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://idmonitor:changeme@localhost:5432/idmonitor?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=idmonitor
DB_PASSWORD=changeme
DB_NAME=idmonitor
DB_SSLMODE=disable

# Authentication
JWT_SECRET=change-this-to-a-random-64-char-string
SESSION_SECRET=change-this-to-a-random-64-char-string
SESSION_MAX_AGE=86400

# 2FA / TOTP
TOTP_ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# Encryption
ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# Admin Bootstrap
IDMONITOR_ADMIN_EMAIL=admin@idmonitor.local
IDMONITOR_ADMIN_PASSWORD=changeme

# SMTP (Email Notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@idmonitor.local

# Telegram Notifications
TELEGRAM_BOT_TOKEN=

# Discord Notifications
DISCORD_WEBHOOK_URL=

# Slack Notifications
SLACK_WEBHOOK_URL=

# Agent
AGENT_HEARTBEAT_INTERVAL=30
AGENT_SERVER_URL=http://localhost:8080

# Scanner
NMAP_PATH=/usr/bin/nmap
SCAN_MAX_CONCURRENT=3
SCAN_DEFAULT_TIMEOUT=300

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=100

# Retention
METRIC_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=365
SCAN_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
