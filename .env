# IDmonitor Environment Configuration

# Application
APP_NAME=IDmonitor
APP_ENV=production
APP_DEBUG=false
APP_PORT=8080
APP_FRONTEND_URL=http://localhost:3000

# Database (Docker service name "database" as host)
DATABASE_URL=postgres://idmonitor:changeme@database:5432/idmonitor?sslmode=disable
DB_HOST=database
DB_PORT=5432
DB_USER=idmonitor
DB_PASSWORD=changeme
DB_NAME=idmonitor
DB_SSLMODE=disable

# Authentication
JWT_SECRET=xK8mP2vN5qR9wY3jL6hF0cA4dG7bT1eU8iO3nS5mX2kW9rZ6yJ4pH0vB7
SESSION_SECRET=aB3cD4eF5gH6iJ7kL8mN9oP0qR1sT2uV3wX4yZ5aB6cD7eF8gH9iJ0kL
SESSION_MAX_AGE=86400

# 2FA / TOTP
TOTP_ENCRYPTION_KEY=mN7oP8qR9sT0uV1wX2yZ3aB4cD5e

# Encryption
ENCRYPTION_KEY=fG6hI7jK8lM9nO0pQ1rS2tU3vW4xY5

# Admin Bootstrap
IDMONITOR_ADMIN_EMAIL=admin@idmonitor.local
IDMONITOR_ADMIN_PASSWORD=Admin123!

# SMTP (Email Notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@idmonitor.local

# Agent
AGENT_HEARTBEAT_INTERVAL=30
AGENT_SERVER_URL=http://localhost:8080

# Scanner
NMAP_PATH=/usr/bin/nmap
SCAN_MAX_CONCURRENT=3
SCAN_DEFAULT_TIMEOUT=300

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=100

# Retention
METRIC_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=365
SCAN_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
